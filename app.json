{
  "expo": {
    "name": "TravelOS",
    "slug": "travelos-voice-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7FA"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "TravelOS uses your microphone to listen to your travel question."
        }
      ],
      "expo-video"
    ]
  }
}
